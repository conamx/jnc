---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="서비스 소개 — JNC마케팅" description="JNC마케팅의 마케팅 컨설팅, 광고 대행, 키워드·블로그 마케팅 서비스를 자세히 알아보세요. 법률사무소·학원·소상공인 특화 마케팅 파트너.">
<style>
  /* PAGE HERO */
  .page-hero { background: var(--black); padding: 72px 5% 0; }
  .page-hero-inner { max-width: 1280px; margin: 0 auto; padding-bottom: 56px; }
  .page-eyebrow { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; color: var(--primary); margin-bottom: 16px; }
  .page-hero-title { font-family: var(--font-serif); font-size: clamp(32px, 4.2vw, 52px); line-height: 1.25; letter-spacing: -0.02em; color: white; margin-bottom: 18px; }
  .page-hero-desc { font-size: 16px; color: rgba(255,255,255,0.55); line-height: 1.8; max-width: 560px; margin-bottom: 36px; }
  .hero-service-pills { display: flex; gap: 10px; flex-wrap: wrap; }
  .hero-pill { display: inline-flex; align-items: center; gap: 8px; padding: 10px 20px; border-radius: 100px; border: 1.5px solid rgba(255,255,255,0.12); font-size: 14px; font-weight: 600; color: rgba(255,255,255,0.75); background: rgba(255,255,255,0.05); transition: border-color 0.2s, color 0.2s; }
  .hero-pill:hover { border-color: rgba(255,255,255,0.35); color: white; }

  /* SERVICE TABS */
  .service-tabs-wrap { background: white; border-bottom: 1px solid var(--gray-200); position: sticky; top: 68px; z-index: 100; }
  .service-tabs { max-width: 1280px; margin: 0 auto; padding: 0 5%; display: flex; gap: 0; overflow-x: auto; }
  .service-tab-link { padding: 18px 28px; font-size: 15px; font-weight: 600; color: var(--gray-600); border-bottom: 2px solid transparent; transition: color 0.2s, border-color 0.2s; white-space: nowrap; }
  .service-tab-link:hover { color: var(--black); }
  .service-tab-link.active { color: var(--primary); border-bottom-color: var(--primary); }

  /* SECTIONS */
  .svc-section { padding: 88px 5%; max-width: 1280px; margin: 0 auto; }
  .svc-section + .svc-section { padding-top: 0; }
  .svc-section-divider { border: none; border-top: 1px solid var(--gray-200); margin: 0 5%; }
  .svc-header { display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: start; margin-bottom: 60px; }
  .svc-num { font-family: var(--font-serif); font-size: 72px; font-weight: 700; color: var(--gray-100); line-height: 1; margin-bottom: 16px; }
  .svc-label { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--primary); margin-bottom: 12px; }
  .svc-title { font-family: var(--font-serif); font-size: clamp(26px, 3vw, 38px); line-height: 1.25; letter-spacing: -0.02em; margin-bottom: 18px; }
  .svc-desc { font-size: 16px; color: var(--gray-600); line-height: 1.8; }
  .svc-tags { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 24px; }
  .svc-tag { font-size: 12px; font-weight: 600; padding: 5px 14px; border-radius: 100px; background: var(--primary-light); color: var(--primary); }

  .svc-aside { background: white; border-radius: var(--radius); padding: 28px 24px; box-shadow: var(--shadow-sm); }
  .svc-aside-title { font-size: 13px; font-weight: 700; color: var(--gray-600); margin-bottom: 16px; }
  .svc-check-list { display: flex; flex-direction: column; gap: 10px; }
  .svc-check { display: flex; align-items: flex-start; gap: 10px; font-size: 14px; color: var(--gray-600); line-height: 1.5; }
  .svc-check::before { content: '✓'; color: var(--primary); font-weight: 700; flex-shrink: 0; }
  .svc-aside-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; }
  .svc-aside-row:last-child { margin-bottom: 0; }
  .svc-aside-row-label { font-size: 14px; font-weight: 600; }
  .svc-pill-status { font-size: 12px; padding: 3px 10px; border-radius: 100px; font-weight: 700; }
  .svc-pill-primary { background: var(--primary); color: white; }
  .svc-pill-live { background: var(--gray-600); color: white; }
  .svc-benefit + .svc-benefit { margin-top: 14px; }
  .svc-benefit-title { font-size: 14px; font-weight: 700; margin-bottom: 4px; }
  .svc-benefit-desc { font-size: 13px; color: var(--gray-600); line-height: 1.55; }

  /* INCLUDES */
  .includes-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .include-card { background: white; border-radius: var(--radius); padding: 26px 24px; box-shadow: var(--shadow-sm); border: 1.5px solid var(--gray-100); transition: transform 0.2s, box-shadow 0.2s; }
  .include-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .include-num { font-family: var(--font-serif); font-size: 13px; font-weight: 700; color: var(--primary); margin-bottom: 12px; }
  .include-title { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
  .include-desc { font-size: 13px; color: var(--gray-600); line-height: 1.65; }

  /* PROCESS */
  .process-section { background: white; padding: 72px 5%; margin-top: 60px; }
  .process-inner { max-width: 1280px; margin: 0 auto; }
  .process-label { font-size: 12px; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--primary); margin-bottom: 12px; }
  .process-title { font-family: var(--font-serif); font-size: clamp(22px, 2.5vw, 30px); margin-bottom: 48px; letter-spacing: -0.02em; }
  .process-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0; position: relative; }
  .process-steps::before { content: ''; position: absolute; top: 28px; left: 12.5%; right: 12.5%; height: 1px; background: var(--gray-200); z-index: 0; }
  .process-step { text-align: center; padding: 0 16px; position: relative; z-index: 1; }
  .step-num { width: 56px; height: 56px; border-radius: 50%; background: var(--primary); color: white; font-family: var(--font-serif); font-size: 18px; font-weight: 700; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px; box-shadow: 0 4px 16px rgba(0,82,204,0.3); }
  .step-title { font-size: 15px; font-weight: 700; margin-bottom: 8px; }
  .step-desc { font-size: 13px; color: var(--gray-600); line-height: 1.6; }

  /* FAQ */
  .faq-section { padding: 80px 5%; max-width: 1280px; margin: 0 auto; }
  .faq-title { font-family: var(--font-serif); font-size: clamp(22px, 2.5vw, 30px); letter-spacing: -0.02em; margin-bottom: 40px; }
  .faq-list { display: flex; flex-direction: column; gap: 12px; }
  .faq-item { background: white; border-radius: var(--radius); border: 1.5px solid var(--gray-100); overflow: hidden; }
  .faq-q { padding: 22px 28px; font-size: 15px; font-weight: 700; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; user-select: none; transition: background 0.2s; }
  .faq-q:hover { background: var(--gray-100); }
  .faq-q::after { content: '+'; font-size: 22px; font-weight: 400; color: var(--gray-400); flex-shrink: 0; transition: transform 0.3s; }
  .faq-item.open .faq-q::after { transform: rotate(45deg); }
  .faq-a { max-height: 0; overflow: hidden; padding: 0 28px; font-size: 14px; color: var(--gray-600); line-height: 1.75; transition: max-height 0.35s ease, padding 0.3s; }
  .faq-item.open .faq-a { max-height: 400px; padding: 0 28px 24px; }

  @media (max-width: 1024px) {
    .svc-header { grid-template-columns: 1fr; gap: 0; }
    .svc-header > div:last-child { margin-top: 40px; }
    .includes-grid { grid-template-columns: 1fr 1fr; }
    .process-steps { grid-template-columns: 1fr 1fr; gap: 40px; }
    .process-steps::before { display: none; }
  }
  @media (max-width: 768px) {
    .page-hero { padding: 52px 20px 0; }
    .page-hero-inner { padding-bottom: 40px; }
    .service-tab-link { padding: 16px 20px; font-size: 14px; }
    .svc-section { padding: 60px 20px; }
    .svc-section-divider { margin: 0 20px; }
    .includes-grid { grid-template-columns: 1fr; }
    .process-section { padding: 52px 20px; }
    .faq-section { padding: 60px 20px; }
  }
</style>

<!-- PAGE HERO -->
<div class="page-hero">
  <div class="page-hero-inner">
    <div class="page-eyebrow">Services</div>
    <h1 class="page-hero-title">전문직·소상공인을 위한<br>맞춤형 마케팅 서비스</h1>
    <p class="page-hero-desc">법률사무소, 학원, 소상공인 등 업종별 특성을 깊이 이해하는 JNC마케팅의 세 가지 핵심 서비스입니다. 2013년부터 쌓아온 실전 노하우로 매출에 직접 기여합니다.</p>
    <div class="hero-service-pills">
      <a class="hero-pill" href="#consulting">마케팅 컨설팅</a>
      <a class="hero-pill" href="#advertising">광고 대행</a>
      <a class="hero-pill" href="#keyword">키워드·블로그 마케팅</a>
    </div>
  </div>
</div>

<!-- SERVICE TABS -->
<div class="service-tabs-wrap">
  <div class="service-tabs">
    <a class="service-tab-link active" href="#consulting">마케팅 컨설팅</a>
    <a class="service-tab-link" href="#advertising">광고 대행</a>
    <a class="service-tab-link" href="#keyword">키워드·블로그</a>
  </div>
</div>

<!-- 01: 마케팅 컨설팅 -->
<div class="svc-section" id="consulting">
  <div class="svc-header">
    <div>
      <div class="svc-num">01</div>
      <div class="svc-label">Marketing Consulting</div>
      <h2 class="svc-title">마케팅 컨설팅</h2>
      <p class="svc-desc">업종별 현황 진단부터 실행 가능한 전략 수립까지. 법률, 교육 등 전문직 특성에 맞춘 맞춤형 로드맵을 제공합니다. 단순한 이론이 아니라 실제 현장에서 검증된 방법으로 접근합니다.</p>
      <div class="svc-tags">
        <span class="svc-tag">현황 진단</span>
        <span class="svc-tag">전략 수립</span>
        <span class="svc-tag">업종별 특화</span>
        <span class="svc-tag">실행 로드맵</span>
      </div>
    </div>
    <div class="svc-aside">
      <div class="svc-aside-title">이런 분께 추천드려요</div>
      <div class="svc-check-list">
        <div class="svc-check">마케팅을 시작하고 싶은데 어디서부터 해야 할지 모르는 분</div>
        <div class="svc-check">광고비를 쓰고 있지만 효과가 없는 것 같은 분</div>
        <div class="svc-check">법률사무소·학원 등 업종 특화 전략이 필요한 분</div>
        <div class="svc-check">마케팅 채널이 많아서 무엇을 해야 할지 모르는 분</div>
      </div>
    </div>
  </div>

  <div class="includes-grid">
    {[
      ['01','현황 진단','현재 마케팅 채널 분석, 경쟁사 벤치마크, 키워드 포지션 진단. 문제가 어디에 있는지 명확하게 짚어드립니다.'],
      ['02','업종별 전략 수립','법률·교육·소상공인 각 업종의 고객 심리와 검색 패턴을 반영한 맞춤 마케팅 전략을 수립합니다.'],
      ['03','실행 로드맵 제공','단계별로 바로 실행 가능한 마케팅 로드맵. 우선순위와 일정, 예산 배분까지 구체적으로 제시합니다.'],
      ['04','성과 지표 설계','어떤 지표를 어떻게 측정할지, KPI를 명확히 설계합니다. 마케팅 투자 효과를 숫자로 확인할 수 있게 합니다.'],
      ['05','정기 보고 & 피드백','월별 성과 리포트와 전략 조정 미팅. 시장 변화에 맞게 지속적으로 전략을 업데이트합니다.'],
      ['06','무료 30분 상담','시작 전 30분 무료 상담을 통해 현재 상황을 진단하고 어떤 서비스가 맞는지 확인해드립니다.'],
    ].map(([num,title,desc]) => (
      <div class="include-card">
        <div class="include-num">{num}</div>
        <div class="include-title">{title}</div>
        <div class="include-desc">{desc}</div>
      </div>
    ))}
  </div>
</div>

<hr class="svc-section-divider">

<div class="process-section">
  <div class="process-inner">
    <div class="process-label">How It Works</div>
    <div class="process-title">마케팅 컨설팅 진행 과정</div>
    <div class="process-steps">
      {[
        ['1','무료 상담','30분 무료 상담으로 현황을 파악하고 방향을 잡습니다'],
        ['2','현황 진단','채널 분석, 경쟁사 리서치, 키워드 포지션 분석'],
        ['3','전략 수립','업종 특화 마케팅 전략과 실행 로드맵 제작'],
        ['4','실행 & 모니터링','월별 리포트와 성과 분석으로 지속적으로 최적화'],
      ].map(([num,title,desc]) => (
        <div class="process-step">
          <div class="step-num">{num}</div>
          <div class="step-title">{title}</div>
          <div class="step-desc">{desc}</div>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- 02: 광고 대행 -->
<div class="svc-section" id="advertising" style="padding-top:80px">
  <div class="svc-header">
    <div>
      <div class="svc-num">02</div>
      <div class="svc-label">Ad Management</div>
      <h2 class="svc-title">광고 대행</h2>
      <p class="svc-desc">네이버, 구글, 메타 광고를 데이터 기반으로 운영합니다. 소상공인·전문직 예산 규모에 맞게 낭비 없이 전환율을 극대화합니다. 한 달 광고비부터 효율을 끌어냅니다.</p>
      <div class="svc-tags">
        <span class="svc-tag">네이버 광고</span>
        <span class="svc-tag">구글 광고</span>
        <span class="svc-tag">SNS 광고</span>
        <span class="svc-tag">데이터 기반 운영</span>
      </div>
    </div>
    <div class="svc-aside">
      <div class="svc-aside-title">광고 채널 운영 현황</div>
      <div class="svc-aside-row"><span class="svc-aside-row-label">네이버 검색광고</span><span class="svc-pill-status svc-pill-primary">핵심 채널</span></div>
      <div class="svc-aside-row"><span class="svc-aside-row-label">구글 검색 & 디스플레이</span><span class="svc-pill-status svc-pill-live">운영 중</span></div>
      <div class="svc-aside-row"><span class="svc-aside-row-label">메타 (인스타·페이스북)</span><span class="svc-pill-status svc-pill-live">운영 중</span></div>
      <div class="svc-aside-row"><span class="svc-aside-row-label">카카오 광고</span><span class="svc-pill-status svc-pill-live">운영 중</span></div>
    </div>
  </div>

  <div class="includes-grid">
    {[
      ['01','타겟 설정 최적화','업종별 핵심 고객층을 정밀하게 타겟팅합니다. 지역, 연령, 관심사 기반으로 낭비 클릭을 줄입니다.'],
      ['02','광고 소재 제작','클릭률을 높이는 광고 문구와 이미지 제작. 업종별 고객 심리를 반영한 카피라이팅.'],
      ['03','예산 효율 극대화','소상공인 예산에 맞는 입찰 전략. CPC, ROAS 목표 기반으로 광고비 낭비 없이 운영합니다.'],
      ['04','성과 리포트','매월 상세한 성과 리포트를 제공합니다. 노출, 클릭, 전환, 비용 데이터를 알기 쉽게 정리합니다.'],
      ['05','A/B 테스트','광고 소재와 랜딩 페이지를 지속적으로 테스트해 최고 성과의 조합을 찾아냅니다.'],
      ['06','전화 · 문의 추적','광고를 통한 전화 문의, 카카오톡 문의, 폼 제출까지 모든 전환을 추적하고 최적화합니다.'],
    ].map(([num,title,desc]) => (
      <div class="include-card">
        <div class="include-num">{num}</div>
        <div class="include-title">{title}</div>
        <div class="include-desc">{desc}</div>
      </div>
    ))}
  </div>
</div>

<hr class="svc-section-divider">

<div class="process-section">
  <div class="process-inner">
    <div class="process-label">How It Works</div>
    <div class="process-title">광고 대행 진행 과정</div>
    <div class="process-steps">
      {[
        ['1','광고 계정 세팅','채널별 광고 계정 세팅 및 전환 추적 설치'],
        ['2','키워드·타겟 설계','업종 특화 키워드 발굴 및 타겟 오디언스 설정'],
        ['3','소재 제작 & 런칭','광고 문구·이미지 제작 후 캠페인 론칭'],
        ['4','최적화 & 리포트','주기적 최적화와 월간 성과 리포트 제공'],
      ].map(([num,title,desc]) => (
        <div class="process-step">
          <div class="step-num">{num}</div>
          <div class="step-title">{title}</div>
          <div class="step-desc">{desc}</div>
        </div>
      ))}
    </div>
  </div>
</div>

<!-- 03: 키워드·블로그 마케팅 -->
<div class="svc-section" id="keyword" style="padding-top:80px">
  <div class="svc-header">
    <div>
      <div class="svc-num">03</div>
      <div class="svc-label">Keyword & Blog Marketing</div>
      <h2 class="svc-title">키워드 · 블로그 마케팅</h2>
      <p class="svc-desc">검색 상위 노출로 지속적인 무료 트래픽을 확보합니다. 법률·교육·소상공인 업종의 핵심 키워드 전략으로 광고비 없이도 매달 잠재 고객이 찾아오게 만듭니다.</p>
      <div class="svc-tags">
        <span class="svc-tag">키워드 분석</span>
        <span class="svc-tag">블로그 마케팅</span>
        <span class="svc-tag">콘텐츠 SEO</span>
        <span class="svc-tag">네이버 상위 노출</span>
      </div>
    </div>
    <div class="svc-aside">
      <div class="svc-aside-title">키워드 마케팅의 장점</div>
      <div class="svc-benefit">
