<!-- CTA + FORM -->
<div class="cta-wrap" id="contact-form">
  <div class="cta-inner">
    <div>
      <div class="cta-label">무료 상담</div>
      <div class="cta-title">어떤 서비스가 맞는지<br>모르겠다면 먼저 물어보세요</div>
      <p class="cta-desc">30분 무료 상담으로 현재 상황을 진단하고 가장 적합한 서비스를 안내드립니다. 비용이나 계약 부담 없이 편하게 문의해주세요.</p>
      <div class="cta-checklist">
        <div class="cta-check">30분 무료 컨설팅</div>
        <div class="cta-check">계약 전 어떤 서비스가 맞는지 안내</div>
        <div class="cta-check">2013년부터 쌓인 업종별 인사이트 공유</div>
      </div>
    </div>
    <div class="form-card">
      <div class="form-card-title">무료 상담 신청</div>
      <div class="form-card-sub">1~2 영업일 내로 연락드립니다.</div>
      <form name="contact" method="POST" data-netlify="true">
        <input type="hidden" name="form-name" value="contact">
        <label class="f-label">이름 *</label>
        <input class="f-input" name="name" type="text" placeholder="홍길동" required>
        <label class="f-label">연락처 *</label>
        <input class="f-input" name="phone" type="tel" placeholder="010-0000-0000" required>
        <label class="f-label">관심 서비스</label>
        <select class="f-select" name="service">
          <option value="">선택해주세요 (선택 사항)</option>
          <option value="consulting">마케팅 컨설팅</option>
          <option value="advertising">광고 대행</option>
          <option value="keyword">키워드·블로그 마케팅</option>
          <option value="all">전체 / 모르겠어요</option>
        </select>
        <label class="f-label">문의 내용 *</label>
        <textarea class="f-textarea" name="message" placeholder="업종, 현재 상황, 궁금한 점 등을 자유롭게 적어주세요." required></textarea>
        <button class="f-btn" type="submit">무료 상담 신청하기 →</button>
        <div class="f-note">개인정보는 상담 목적 외 사용되지 않습니다.</div>
      </form>
    </div>
  </div>
</div>

<script>
  // FAQ 아코디언
  document.querySelectorAll('.faq-q').forEach((q) => {
    q.addEventListener('click', () => {
      const item = q.closest('.faq-item') as HTMLElement;
      const isOpen = item.classList.contains('open');
      document.querySelectorAll('.faq-item').forEach(i => i.classList.remove('open'));
      if (!isOpen) item.classList.add('open');
    });
  });

  // 탭 클릭 시 활성화
  const tabLinks = document.querySelectorAll('.service-tab-link');
  tabLinks.forEach((t) => {
    t.addEventListener('click', () => {
      tabLinks.forEach(x => x.classList.remove('active'));
      t.classList.add('active');
    });
  });

  // 스크롤 위치에 따라 탭 자동 활성화
  const sections = ['consulting', 'advertising', 'keyword'];
  window.addEventListener('scroll', () => {
    let current = '';
    sections.forEach(id => {
      const el = document.getElementById(id);
      if (el && window.scrollY >= (el as HTMLElement).offsetTop - 160) current = id;
    });
    tabLinks.forEach(t => {
      t.classList.remove('active');
      if (t.getAttribute('href') === '#' + current) t.classList.add('active');
    });
  });
</script>
</BaseLayout>
